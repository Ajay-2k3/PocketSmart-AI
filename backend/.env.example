# PocketSmart AI Backend — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# ── App ──────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Supabase ─────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ── Gemini AI ─────────────────────────────────────────────────
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT=60

# ── Mock Modes ────────────────────────────────────────────────
# Set to false only after configuring Gemini API key above
GEMINI_MOCK_MODE=true
# Set to "live" only when a real product provider is integrated
PRODUCT_PROVIDER_MODE=mock

# ── Image Upload ──────────────────────────────────────────────
MAX_IMAGE_SIZE_BYTES=5242880
IMAGE_STORAGE_BUCKET=planner-images
